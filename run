#!/usr/bin/env bash
#
# Start this install: the API, the job worker, and optionally the watch helper (spec 6.11).
#
# Why a script and not a bundled executable:
#
#   - The three processes are not interchangeable. The audit log is hash-chained, so exactly
#     one writer may run (invariant 6); the worker is a separate process on purpose, and the
#     helper is operator-started by definition. A launcher has to express that, and a frozen
#     binary would only hide it.
#   - macOS keys the Screen Recording grant to the binary that asks. A signed, notarised app
#     bundle would own its own grant; an unsigned PyInstaller build loses the grant on every
#     rebuild, which is worse than inheriting the terminal's.
#   - Invariant 1 is auditable from a readable tree plus `uv.lock`. It is not auditable from
#     a 400 MB blob.
#
# Usage:
#   ./run                 API + worker, in the foreground; Ctrl-C stops both
#   ./run --watch         ... and the watch helper (macOS only)
#   ./run --port 8001     a different loopback port
#   ./run --no-ui-build   skip building frontend/dist when it is missing
#
set -euo pipefail

# Job control, so each child is a process-group leader: `uv run` forks python, and a signal
# sent to the group reaches the python that is actually doing the work.
set -m

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
LOG_DIR="$ROOT/data/logs"

# Invariant 11: loopback only, and not configurable from here.
HOST=127.0.0.1
PORT=8000
READY_TIMEOUT=90

WITH_WATCH=0
BUILD_UI=1

API=""
WORKER=""
WATCH=""
TAIL=""

say() { printf '\033[1m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[33m warn\033[0m %s\n' "$*" >&2; }
die() {
  printf '\033[31merror\033[0m %s\n' "$*" >&2
  exit 1
}

usage() {
  sed -n '17,21p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
  --watch) WITH_WATCH=1 ;;
  --no-ui-build) BUILD_UI=0 ;;
  --port)
    [ $# -ge 2 ] || die "--port needs a number"
    PORT="$2"
    shift
    ;;
  -h | --help)
    usage
    exit 0
    ;;
  *) die "unknown option: $1" ;;
  esac
  shift
done

stop_group() {
  # TERM the group, give it a moment, then KILL whatever is left.
  local pid="$1"
  [ -n "$pid" ] || return 0
  kill -TERM "-$pid" 2>/dev/null || true
}

cleanup() {
  trap '' INT TERM EXIT
  say "stopping"
  [ -n "$TAIL" ] && kill "$TAIL" 2>/dev/null || true
  stop_group "$WATCH"
  stop_group "$WORKER"
  stop_group "$API"
  sleep 2
  for pid in "$WATCH" "$WORKER" "$API"; do
    [ -n "$pid" ] && kill -KILL "-$pid" 2>/dev/null || true
  done
  wait 2>/dev/null || true
}

# ------------------------------------------------------------------ preflight

command -v uv >/dev/null 2>&1 || die "uv is not installed (https://docs.astral.sh/uv/)"

if lsof -nP -iTCP:"$PORT" -sTCP:LISTEN >/dev/null 2>&1; then
  die "something is already listening on $HOST:$PORT — stop it, or pass --port"
fi

if [ "$BUILD_UI" -eq 1 ] && [ ! -f "$ROOT/frontend/dist/index.html" ]; then
  if command -v bun >/dev/null 2>&1; then
    say "building the frontend (frontend/dist is missing)"
    (cd "$ROOT/frontend" && bun install && bun run build)
  else
    warn "frontend/dist is missing and bun is not installed: the API will serve no UI"
  fi
fi

if [ "$WITH_WATCH" -eq 1 ]; then
  [ "$(uname -s)" = "Darwin" ] || die "the watch helper is macOS only (spec 6.11)"
  (cd "$BACKEND" && uv run --extra watch python -c "import PySide6" >/dev/null 2>&1) ||
    die "the watch extra is not installed: cd backend && uv sync --extra dev --extra watch"
fi

# Schema and models.lock before anything serves: a weight whose bytes moved must stop the
# start with one sentence (invariant 8), not a traceback out of uvicorn's lifespan.
say "checking schema and models.lock"
(cd "$BACKEND" && uv run python -m app.cli check)

mkdir -p "$LOG_DIR"
trap cleanup INT TERM EXIT

# --------------------------------------------------------------------- start

# The helper reads its backend URL from the environment (`watch/config.py`). Exporting it
# here is what lets a helper the API starts on request (POST /api/watch/launch, spec 6.11)
# find this install on a non-default port without a port reaching any command line.
export FACEYMATCH_URL="http://$HOST:$PORT"

say "API on http://$HOST:$PORT"
(cd "$BACKEND" && exec uv run uvicorn app.main:app --host "$HOST" --port "$PORT" --workers 1) \
  >>"$LOG_DIR/api.log" 2>&1 &
API=$!

ready=0
for _ in $(seq 1 "$READY_TIMEOUT"); do
  if curl -fsS -m 2 "http://$HOST:$PORT/api/healthz" >/dev/null 2>&1; then
    ready=1
    break
  fi
  kill -0 "$API" 2>/dev/null || {
    tail -n 20 "$LOG_DIR/api.log" >&2
    die "the API exited during startup (see $LOG_DIR/api.log)"
  }
  sleep 1
done
[ "$ready" -eq 1 ] || die "the API did not answer within ${READY_TIMEOUT}s"

# One worker, one writer: the audit chain serialises every append behind the previous hash
# (invariant 6), so a second worker is a corruption risk and not a speedup.
say "job worker"
(cd "$BACKEND" && exec uv run python -m app.worker) >>"$LOG_DIR/worker.log" 2>&1 &
WORKER=$!

if [ "$WITH_WATCH" -eq 1 ]; then
  # The Screen Recording grant follows whatever launched this, so the first run prompts for
  # the terminal, not for python.
  say "watch helper"
  (cd "$BACKEND" && exec uv run --extra watch python -m watch --url "http://$HOST:$PORT") \
    >>"$LOG_DIR/watch.log" 2>&1 &
  WATCH=$!
fi

say "ready — http://$HOST:$PORT  (Ctrl-C to stop; logs in data/logs)"
tail -n 0 -F "$LOG_DIR/api.log" "$LOG_DIR/worker.log" &
TAIL=$!

# Watch the services rather than blocking on one of them: a crashed worker must not leave a
# half-running install looking healthy. `wait -n` would do it in bash 4.3+, and macOS ships
# 3.2.
while :; do
  kill -0 "$API" 2>/dev/null || die "the API exited (see $LOG_DIR/api.log)"
  kill -0 "$WORKER" 2>/dev/null || die "the job worker exited (see $LOG_DIR/worker.log)"
  if [ -n "$WATCH" ] && ! kill -0 "$WATCH" 2>/dev/null; then
    # The helper is operator-started and operator-stopped; closing it is not a fault.
    say "the watch helper closed; the API and worker are still running"
    WATCH=""
  fi
  sleep 1
done
